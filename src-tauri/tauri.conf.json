{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laverna",
  "version": "0.1.1",
  "identifier": "dev.abjshawty.laverna",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Laverna",
        "width": 760,
        "height": 540,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "publisher": "Timmy Kouadio-Bhegnin",
    "shortDescription": "A minimal desktop app for downloading videos with yt-dlp",
    "longDescription": "Laverna queues videos and downloads them one after the other with yt-dlp, with selectable quality, subtitles, and a customizable theme.",
    "linux": {
      "deb": {
        "recommends": [
          "yt-dlp",
          "ffmpeg"
        ],
        "section": "video"
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}
